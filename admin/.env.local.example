# Admin panel configuration.
#
# Copy to .env.local for local work. The same names are set as service
# variables on Railway (project inature-admin); nothing here is read from a
# file in production. Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# Sign-in. Both are required: with either missing the panel fails closed and
# rejects every login rather than letting anyone in.
# ---------------------------------------------------------------------------

# The shared team password. Must be at least 12 characters.
ADMIN_PASSWORD=

# Signs the session cookie (HMAC-SHA256). Any long random string; generate one
# with: openssl rand -base64 48
AUTH_SECRET=

# Session generation. Sessions carry this value inside their signature, so
# raising the number signs everybody out immediately, without rotating
# AUTH_SECRET and without a database. Defaults to 1 when unset. Sessions also
# expire on their own after 7 days (SESSION_MAX_AGE in lib/auth.ts).
SESSION_EPOCH=1

# ---------------------------------------------------------------------------
# Shopify. With no credentials at all the panel serves realistic mock data, so
# the whole UI still renders; that is the local default.
# ---------------------------------------------------------------------------

SHOPIFY_SHOP=inature-uk.myshopify.com
SHOPIFY_BLOG_HANDLE=news

# Either a static Admin API access token...
SHOPIFY_ADMIN_TOKEN=

# ...or a client credentials pair, exchanged for a token at request time.
# This is what production uses; SHOPIFY_ADMIN_TOKEN is not set there.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Google. Optional: without these the traffic, search and index cards say so
# and the rest of the dashboard works normally.
# ---------------------------------------------------------------------------

# Service account JSON, as a single line. The account needs GA4 Viewer on the
# property and must be added as a user on the Search Console property.
GOOGLE_SERVICE_ACCOUNT_JSON=

# GA4 numeric property id (digits only, no "properties/" prefix).
GA4_PROPERTY_ID=

# Search Console property, exactly as it is registered there.
GSC_SITE_URL=https://inatureltd.co.uk/
