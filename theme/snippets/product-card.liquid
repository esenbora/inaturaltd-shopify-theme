{%- liquid
  assign p = product
  assign rating = p.metafields.reviews.rating.value
  assign review_count = p.metafields.reviews.count.value
  assign tagline = p.metafields.custom.tagline.value | default: p.type
  comment
    These products lead with a promo/dark-bg shot in Shopify; show the clean white pack shot first for a consistent grid.
  endcomment
  assign primary_image = p.featured_image
  assign secondary_image = p.images.last
  case p.handle
    when 'incia-natural-deodorant-for-sensitive-skin' or 'incia-eyelash-serum-for-eyelashes-and-eyebrows' or 'incia-natural-deodorant-for-dark-armpits'
      assign primary_image = p.images[1]
    when 'incia-sunscreen-stick-spf-50-with-mineral-filters'
      assign primary_image = p.images[0]
      assign secondary_image = p.images[2]
  endcase
-%}
<article class="product-card">
  <a href="{{ p.url }}" class="product-card__media" aria-label="{{ p.title }}">
    <div class="product-card__badges">
      {% if p.compare_at_price > p.price %}
        <span class="pill pill-accent">−{{ p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round: 0 }}%</span>
      {% endif %}
      {% if p.tags contains 'new' %}<span class="pill pill-soft">New</span>{% endif %}
      {% if p.tags contains 'bestseller' %}<span class="pill pill-soft">Bestseller</span>{% endif %}
    </div>
    {% if primary_image %}
      <img class="product-card__img product-card__img--primary" src="{{ primary_image | image_url: width: 600 }}" alt="{{ p.title }}" loading="lazy" width="600" height="600">
      {% if p.images.size > 1 %}
        {%- comment -%} Hover shows the lifestyle/coloured shot (last image by default; per-product override above), not the back-of-pack {%- endcomment -%}
        <img class="product-card__img product-card__img--secondary" src="{{ secondary_image | image_url: width: 600 }}" alt="" aria-hidden="true" loading="lazy" width="600" height="600">
      {% endif %}
    {% else %}
      <div class="product-card__placeholder" aria-hidden="true">{% render 'icon', name: 'leaf' %}</div>
    {% endif %}
    <div class="product-card__quick">
      {%- comment -%}
        Personalised items need the name before they can be added, otherwise a
        quick add lands an unnamed keepsake in the basket. Same attribute names
        as the product page so one JS path validates both. The field sits inside
        the card's link, so its events stop there (see theme.js).
      {%- endcomment -%}
      {%- if p.tags contains 'Personalised' -%}
        <div class="card-personalise" data-personalise>
          <input
            class="card-personalise__input"
            type="text"
            maxlength="12"
            autocomplete="off"
            placeholder="Name for the bear"
            data-personalisation
            data-property-name="Name"
            aria-label="Name to personalise {{ p.title | escape }}">
          <p class="card-personalise__error" data-personalisation-error hidden></p>
        </div>
      {%- endif -%}
      <button class="btn btn-primary btn-block btn-sm"
        data-add-to-cart
        data-variant-id="{{ p.variants.first.id }}"
        data-max="{{ p.metafields.custom.max_per_order.value | default: 5 }}"
        data-label="{% if p.tags contains 'Personalised' %}Add with name{% else %}Quick add{% endif %}"
        type="button"
        {% if p.variants.first.available == false %}disabled aria-disabled="true"{% endif %}>
        {%- if p.variants.first.available -%}
          {% if p.tags contains 'Personalised' %}Add with name{% else %}Quick add{% endif %}
        {%- else -%}Sold out{%- endif -%}
      </button>
    </div>
  </a>
  <div>
    <span class="product-card__sub">{{ tagline }}</span>
    <h3 class="product-card__title"><a href="{{ p.url }}">{{ p.title }}</a></h3>
    {% if rating != blank %}
      <span class="rating">
        <span class="rating__stars">{% for i in (1..5) %}★{% endfor %}</span>
        {{ rating }}{% if review_count != blank %} ({{ review_count }}){% endif %}
      </span>
    {% endif %}
    {% render 'price', product: p %}
  </div>
</article>
