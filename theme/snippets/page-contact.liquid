<h2>Send us a message</h2>
{% form 'contact' %}
  {% if form.posted_successfully? %}
    <p class="form-note form-note--ok">Thanks, your message is on its way. We'll reply within one working day.</p>
  {% endif %}
  {% if form.errors %}
    <p class="form-note form-note--err">Sorry, something went wrong. Please email us directly at info@inatureltd.com.</p>
  {% endif %}
  <div class="contact-form">
    <input type="text" name="contact[name]" placeholder="Your name" aria-label="Your name" required>
    <input type="email" name="contact[email]" placeholder="Your email" aria-label="Your email" required>
    <textarea name="contact[body]" placeholder="How can we help?" aria-label="Your message" rows="5" required></textarea>
    <button type="submit" class="btn btn-primary">Send message</button>
  </div>
{% endform %}
