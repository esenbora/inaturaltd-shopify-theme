<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {%- if template == 'index' -%}
        INCIA Natural Skincare, Shipped from the UK | {{ shop.name }}
      {%- elsif page_title -%}
        {{ page_title }} | {{ shop.name }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </title>

    {%- liquid
      assign brand_default_desc = 'INature UK, distributor of INCIA. 100% natural skincare, ETKO Cosmos certified, trusted by 50,000+ families across Europe.'
      if settings.brand_meta_description != blank
        assign brand_default_desc = settings.brand_meta_description
      endif

      assign meta_desc = page_description
      if meta_desc == blank and template == 'index'
        assign meta_desc = 'Shop INCIA natural skincare in the UK: mineral SPF50, baby and mum care, natural deodorant, lip balms and more. 100% natural, dispatched from the UK.'
      endif
      if meta_desc == blank and template contains 'product' and product.description != blank
        assign meta_desc = product.description | strip_html | strip_newlines | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&nbsp;', ' ' | truncate: 160
      endif
      if meta_desc == blank and template contains 'collection' and collection.description != blank
        assign meta_desc = collection.description | strip_html | strip_newlines | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&nbsp;', ' ' | truncate: 160
      endif
      if meta_desc == blank
        assign meta_desc = brand_default_desc
      endif
      comment
        Normalize HTML entities from any source (page_description is often auto-generated
        with &amp; still encoded, which the final | escape would double to &amp;amp;).
      endcomment
      assign meta_desc = meta_desc | strip_html | replace: '&amp;', '&' | replace: '&amp;', '&' | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&nbsp;', ' '
      comment
        SERP backstop: word-safe cap (~150 chars) so an over-long admin page_description does not cut mid-word.
      endcomment
      assign meta_desc = meta_desc | strip | truncatewords: 26, '…'

      assign meta_title = page_title | default: shop.name | replace: '&amp;', '&' | replace: '&amp;', '&' | replace: '&amp;', '&' | replace: '&#39;', "'"
    -%}

    <meta name="description" content="{{ meta_desc | escape }}">

    {%- if template contains 'search' or template contains 'cart' or template contains 'account' or template contains 'checkout' -%}
      <meta name="robots" content="noindex,nofollow">
    {%- endif -%}

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="{% if template contains 'product' %}product{% elsif template contains 'article' %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ meta_title | escape }}">
    <meta property="og:description" content="{{ meta_desc | escape }}">
    {%- if template contains 'product' and product.featured_image -%}
      <meta property="og:image" content="{{ product.featured_image | image_url: width: 1200 }}">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="1200">
    {%- elsif settings.social_share_image -%}
      <meta property="og:image" content="{{ settings.social_share_image | image_url: width: 1200 }}">
    {%- else -%}
      <meta property="og:image" content="{{ 'hero-2.jpg' | asset_url | prepend: 'https:' }}">
    {%- endif -%}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ meta_title | escape }}">
    <meta name="twitter:description" content="{{ meta_desc | escape }}">
    {%- if template contains 'product' and product.featured_image -%}
      <meta name="twitter:image" content="{{ product.featured_image | image_url: width: 1200 }}">
    {%- elsif settings.social_share_image -%}
      <meta name="twitter:image" content="{{ settings.social_share_image | image_url: width: 1200 }}">
    {%- else -%}
      <meta name="twitter:image" content="{{ 'hero-2.jpg' | asset_url | prepend: 'https:' }}">
    {%- endif -%}

    {%- comment -%} Organization + WebSite JSON-LD is emitted sitewide by snippets/structured-data.liquid (rendered below). No inline duplicate here (it caused a doubled Organization on the homepage plus a broken shop.url+asset_url logo). {%- endcomment -%}

    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- comment -%} Preload the LCP hero image (homepage first slide) — responsive per the <picture> 820px breakpoint. {%- endcomment -%}
    {%- if template == 'index' -%}
      <link rel="preload" as="image" href="{{ 'hero-2.jpg' | asset_url }}" media="(min-width: 821px)" fetchpriority="high">
      <link rel="preload" as="image" href="{{ 'hero-2-mobile.jpg' | asset_url }}" media="(max-width: 820px)" fetchpriority="high">
    {%- endif -%}
    {{ content_for_header }}

    {%- liquid
      assign font_heading = settings.font_heading
      assign font_body = settings.font_body
    -%}
    <style>
      {{ font_heading | font_face: font_display: 'swap' }}
      {{ font_body | font_face: font_display: 'swap' }}
      :root {
        --bg: {{ settings.color_bg }};
        --surface: {{ settings.color_surface }};
        --ink: {{ settings.color_ink }};
        --muted: {{ settings.color_muted }};
        --primary: {{ settings.color_primary }};
        --primary-dark: {{ settings.color_primary_dark }};
        --accent: {{ settings.color_accent }};
        --border: {{ settings.color_border }};
        --page-w: {{ settings.page_width }}px;
        --section-y: {{ settings.section_spacing }}px;
        --font-heading: {{ font_heading.family }}, {{ font_heading.fallback_families }};
        --font-body: {{ font_body.family }}, {{ font_body.fallback_families }};
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {% render 'structured-data' %}
    {% render 'behaviour-tracking' %}
  </head>

  <body class="template-{{ template | replace: '.', '-' }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% sections 'header-group' %}

    {% render 'relaunch-note' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
    {% render 'promo-popup' %}
  </body>
</html>
