<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {%- if template == 'index' -%}
        {{ shop.name }} — {{ settings.brand_tagline }}
      {%- elsif page_title -%}
        {{ page_title }} | {{ shop.name }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </title>

    {%- liquid
      assign brand_default_desc = 'INature UK — distributor of INCIA Naturals. 100% natural skincare, ETKO Cosmos certified, trusted by 50,000+ families across Europe.'
      if settings.brand_meta_description != blank
        assign brand_default_desc = settings.brand_meta_description
      endif

      assign meta_desc = page_description
      if meta_desc == blank and template contains 'product' and product.description != blank
        assign meta_desc = product.description | strip_html | truncate: 160
      endif
      if meta_desc == blank and template contains 'collection' and collection.description != blank
        assign meta_desc = collection.description | strip_html | truncate: 160
      endif
      if meta_desc == blank
        assign meta_desc = brand_default_desc
      endif

      assign meta_title = page_title | default: shop.name
    -%}

    <meta name="description" content="{{ meta_desc | escape }}">

    {%- if template contains 'search' or template contains 'cart' or template contains 'account' or template contains 'checkout' -%}
      <meta name="robots" content="noindex,nofollow">
    {%- endif -%}

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="{% if template contains 'product' %}product{% elsif template contains 'article' %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ meta_title | escape }}">
    <meta property="og:description" content="{{ meta_desc | escape }}">
    {%- if template contains 'product' and product.featured_image -%}
      <meta property="og:image" content="{{ product.featured_image | image_url: width: 1200 }}">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="1200">
    {%- elsif settings.social_share_image -%}
      <meta property="og:image" content="{{ settings.social_share_image | image_url: width: 1200 }}">
    {%- endif -%}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ meta_title | escape }}">
    <meta name="twitter:description" content="{{ meta_desc | escape }}">
    {%- if template contains 'product' and product.featured_image -%}
      <meta name="twitter:image" content="{{ product.featured_image | image_url: width: 1200 }}">
    {%- elsif settings.social_share_image -%}
      <meta name="twitter:image" content="{{ settings.social_share_image | image_url: width: 1200 }}">
    {%- endif -%}

    {%- if template == 'index' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "INature",
      "alternateName": "INature UK",
      "url": "{{ shop.url }}",
      "logo": "{{ shop.url }}{{ 'logo.png' | asset_url }}",
      "sameAs": [
        "https://www.instagram.com/inatureltd",
        "https://www.tiktok.com/@inatureltd"
      ],
      "description": "Official UK distributor of INCIA Naturals — 100% natural skincare, ETKO Cosmos certified, dispatched from the UK."
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": "{{ shop.url }}",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ shop.url }}/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {{ content_for_header }}

    {%- liquid
      assign font_heading = settings.font_heading
      assign font_body = settings.font_body
    -%}
    <style>
      {{ font_heading | font_face: font_display: 'swap' }}
      {{ font_body | font_face: font_display: 'swap' }}
      :root {
        --bg: {{ settings.color_bg }};
        --surface: {{ settings.color_surface }};
        --ink: {{ settings.color_ink }};
        --muted: {{ settings.color_muted }};
        --primary: {{ settings.color_primary }};
        --primary-dark: {{ settings.color_primary_dark }};
        --accent: {{ settings.color_accent }};
        --border: {{ settings.color_border }};
        --page-w: {{ settings.page_width }}px;
        --section-y: {{ settings.section_spacing }}px;
        --font-heading: {{ font_heading.family }}, {{ font_heading.fallback_families }};
        --font-body: {{ font_body.family }}, {{ font_body.fallback_families }};
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template | replace: '.', '-' }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
    {% render 'promo-popup' %}
  </body>
</html>
