<section class="hero hero--banner">
  <div class="wrap">
    <div class="hero-banner">
      {% if section.settings.image %}
        <img class="hero-banner__img" src="{{ section.settings.image | image_url: width: 1690 }}" alt="" width="845" height="677" fetchpriority="high">
      {% else %}
        <img class="hero-banner__img" src="{{ 'hero-summer.jpg' | asset_url }}" alt="The INCIA natural sun care range under a beach umbrella" width="2000" height="677" fetchpriority="high">
      {% endif %}
      <div class="hero-banner__overlay">
        <div class="hero-banner__content stack" style="--gap: var(--space-4);">
          <span class="eyebrow">{{ section.settings.eyebrow | default: 'Sun care · now in the UK' }}</span>
          <h1 class="h-display hero__title">{{ section.settings.heading | default: 'Enjoy the sun, <em>naturally</em>.' }}</h1>
          <p class="lead">{{ section.settings.subheading | default: '100% natural mineral SPF50, reef-safe, non-nano, safe for babies. Loved by 50,000+ families across Europe, now in the UK.' }}</p>
          <div class="cluster" style="--gap: var(--space-3);">
            <a href="{{ section.settings.cta_primary_url | default: '/collections/sun-care' }}" class="btn btn-primary btn-lg">
              {{ section.settings.cta_primary_label | default: 'Shop sun care' }}
              {% render 'icon', name: 'arrow-right' %}
            </a>
            <a href="{{ section.settings.cta_secondary_url | default: routes.all_products_collection_url }}" class="btn btn-ghost btn-lg">{{ section.settings.cta_secondary_label | default: 'Shop all' }}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Naturals, UK collection" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Skincare with <em>roots</em>, made for modern routines.</p>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_primary_label", "label": "Primary CTA label", "default": "Shop the edit" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary CTA label", "default": "Read our story" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA URL" },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
