<section class="hero hero--banner">
  <div class="wrap">
    <div class="hero-banner" data-hero-carousel>
      {%- comment -%}
        Slaytlar tek bir listeden uretilir. Onceden her kare elle yazilmis bir
        <picture> blogu, noktalar da ayri bir el listesiydi; slayt eklenince
        nokta sayisini guncellemeyi unutmak kolaydi. Simdi ikisi de ayni
        listeden geliyor, sayilari birbirinden sapamaz.

        Mobil karsiligi her zaman "<dosya>-mobile.jpg": tema 820px altinda
        gorseli uste alip metni altina yiyor ve urun odakli dar bir kirpim
        bekliyor (bkz. base.css).

        Gorsellerin tamami ayni yontemle uretildi: sahne yapay zeka, URUN ise
        gercek studyo fotografindan kesilip yerlestirildi. Onceki set bastan
        sona yapay zeka uretimiydi ve ambalaj metinleri halusinasyondu —
        hero-2 "NON HANO MINERAL FILTER" / "AETRA HIGH PROTECTION" (gercegi
        NON NANO / ULTRA HIGH), hero-4 "AVGEAND BIL" (AVOCADO OIL), hero-7
        "CRECKCE NATURAL" (COSMOS NATURAL). SPF iddiasi tasiyan bir urunde bu
        kozmetik bir kusur degildi.
      {%- endcomment -%}
      {%- liquid
        assign slide_files = 'hero-autumn-group,hero-autumn,hero-2,hero-3,hero-4,hero-5,hero-6,hero-7' | split: ','
        assign slide_alts = 'INCIA autumn range on an oak harvest table with dried leaves and acorns|INCIA SOS Stick on woodland bark with acorns and rosehips|INCIA natural face sunscreen SPF50 on sunlit beach sand|INCIA natural baby and kids shampoo on a bath rim beside a folded towel|INCIA intensive repair care cream on marble with linen and lavender|INCIA natural lip balm nestled in a knitted wool blanket|INCIA foaming facial cleanser on a wet ceramic washbasin|INCIA natural herbal shampoo on an olive wood board with fresh herbs' | split: '|'
      -%}
      <div class="hero-banner__slides">
        {%- for file in slide_files -%}
          <div class="hero-banner__slide{% if forloop.first %} is-active{% endif %}">
            <picture>
              <source media="(max-width: 820px)" srcset="{{ file | append: '-mobile.jpg' | asset_url }}">
              <img class="hero-banner__img"
                   src="{{ file | append: '.jpg' | asset_url }}"
                   alt="{{ slide_alts[forloop.index0] | escape }}"
                   width="2000" height="848"
                   {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
            </picture>
          </div>
        {%- endfor -%}
        <div class="hero-banner__dots" role="tablist" aria-label="Banner slides">
          {%- for file in slide_files -%}
            <button type="button"{% if forloop.first %} class="is-active"{% endif %} aria-label="Slide {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      </div>

      <div class="hero-banner__overlay">
        <div class="hero-banner__content stack" style="--gap: var(--space-4);">
          <span class="eyebrow">{{ section.settings.eyebrow | default: '100% natural · now in the UK' }}</span>
          <h1 class="h-display hero__title">Clean care, <em>naturally.</em></h1>
          <p class="lead">{{ section.settings.subheading | default: '100% natural, dermatologically tested skincare for the whole family, sun care, baby, face and body. Trusted by 50,000+ across Europe, now in the UK.' }}</p>
          <div class="cluster" style="--gap: var(--space-3);">
            <a href="{{ section.settings.cta_primary_url | default: routes.all_products_collection_url }}" class="btn btn-primary btn-lg">
              {{ section.settings.cta_primary_label | default: 'Shop the range' }}
              {% render 'icon', name: 'arrow-right' %}
            </a>
            <a href="{{ section.settings.cta_secondary_url | default: '/collections/bestsellers-1' }}" class="btn btn-ghost btn-lg">{{ section.settings.cta_secondary_label | default: 'Bestsellers' }}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var hero = document.querySelector('[data-hero-carousel]');
    if (!hero) return;
    var slides = hero.querySelectorAll('.hero-banner__slide');
    var dots = hero.querySelectorAll('.hero-banner__dots button');
    if (slides.length < 2) { hero.querySelector('.hero-banner__dots').style.display = 'none'; return; }
    var i = 0, timer;
    function go(n) {
      slides[i].classList.remove('is-active');
      if (dots[i]) dots[i].classList.remove('is-active');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('is-active');
      if (dots[i]) dots[i].classList.add('is-active');
    }
    function start() { timer = setInterval(function () { go(i + 1); }, 5500); }
    dots.forEach(function (d, n) {
      d.addEventListener('click', function () { clearInterval(timer); go(n); start(); });
    });
    start();
  })();
</script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sun care · now in the UK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Enjoy the sun, <em>naturally</em>." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_primary_label", "label": "Primary CTA label", "default": "Shop sun care" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary CTA label", "default": "Shop all" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA URL" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
