<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <span class="brand-mark"><span class="brand-i">I</span><span class="brand-leaf-wrap"><span class="brand-verb" data-brand-verb>am</span><img class="brand-leaf" src="{{ 'brand-leaf.png' | asset_url }}" width="502" height="293" alt="" aria-hidden="true" loading="lazy"></span><span class="brand-nature">Nature</span></span>
        <p style="font-size: var(--fs-sm); color: rgba(248,244,237,.7); max-width: 38ch;">
          {{ section.settings.about_text | default: '100% natural skincare from Türkiye, dispatched in the UK. The official UK distributor of INCIA Naturals — trusted by 50,000+ families across Europe.' }}
        </p>
        <div class="site-footer__social mt-4">
          {% if settings.social_instagram != blank %}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          {% endif %}
          {% if settings.social_tiktok != blank %}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
          {% endif %}
          {% if settings.social_facebook != blank %}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
          {% endif %}
        </div>
      </div>

      <div>
        <h5>Shop</h5>
        <ul class="site-footer__links">
          <li><a href="/collections/bestsellers">Bestsellers</a></li>
          <li><a href="/collections/mom-baby-care">Mum &amp; Baby Care</a></li>
          <li><a href="/collections/personal-care">Personal Care</a></li>
          <li><a href="/collections/sun-care">Sun Care</a></li>
          <li><a href="/collections/lip-balms">Lip Balms</a></li>
          <li><a href="/collections/sale">Sale</a></li>
        </ul>
      </div>
      <div>
        <h5>Help</h5>
        <ul class="site-footer__links">
          <li><a href="/pages/shipping-returns">Shipping &amp; returns</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/contact">Contact us</a></li>
          <li><a href="{{ routes.account_url }}">My account</a></li>
        </ul>
      </div>
      <div>
        <h5>Brand</h5>
        <ul class="site-footer__links">
          <li><a href="/pages/about">Our story</a></li>
          <li><a href="/blogs/news">Journal</a></li>
          <li><a href="/pages/terms-conditions">Terms &amp; conditions</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }} · Official UK distributor of INCIA Naturals</span>
      <span>Free UK shipping over £20 · 14-day returns · info@inatureltd.com</span>
      <span>
        <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy</a> ·
        <a href="/pages/terms-conditions">Terms</a> ·
        <a href="/pages/shipping-returns">Returns</a>
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "about_text", "label": "About text" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 4,
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
