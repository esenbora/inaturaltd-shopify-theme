        {% render 'mock-product-card',
          image: 'https://static.wixstatic.com/media/bf3c53_9022dfde05d44856a1b2ccc4d51b2053f002.jpg/v1/fill/w_600,h_600,al_c,q_85/bf3c53_9022dfde05d44856a1b2ccc4d51b2053f002.jpg',
          title: 'INCIA Intensive Repair Care Cream for Dry Skin', sub: 'Intensive repair cream · Eczema-friendly · Shea butter & vitamin E · 50 ml',
          price: '9', was: '11', rating: '4.8', reviews: '256', url: '/products/incia-intensive-repair-care-cream-for-dry-skin' %}
      {%- endif -%}
    </div>
  </div>
</section>

<div style="height: var(--space-8);" aria-hidden="true"></div>

