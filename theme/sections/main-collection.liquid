<section class="collection-hero">
  <div class="wrap">
    <h1 class="h1">{{ collection.title | default: 'The full INCIA range, distributed in the UK.' }}</h1>
    {% if collection.description != blank %}
      <p class="lead muted mt-3 mx-auto" style="max-width: 60ch;">{{ collection.description }}</p>
    {% else %}
      <p class="lead muted mt-3 mx-auto" style="max-width: 60ch;">{{ collections.all.products_count }} natural products from INCIA, already trusted across Europe for over 5 years. Now dispatched from the UK by INature.</p>
    {% endif %}
  </div>
</section>

<section>
  <div class="wrap">
    <div class="collection-toolbar">
      <div class="filter-pills">
        {%- assign current_handle = collection.handle | default: 'all-products' -%}
        <a href="{{ routes.all_products_collection_url }}" class="pill {% if current_handle == 'all-products' or current_handle == '' %}pill-soft{% endif %}">All</a>
        <a href="/collections/bestsellers" class="pill {% if current_handle == 'bestsellers' %}pill-soft{% endif %}">Bestsellers</a>
        <a href="/collections/mom-baby-care" class="pill {% if current_handle == 'mom-baby-care' %}pill-soft{% endif %}">Mom &amp; Baby</a>
        <a href="/collections/personal-care" class="pill {% if current_handle == 'personal-care' %}pill-soft{% endif %}">Personal Care</a>
        <a href="/collections/sun-care" class="pill {% if current_handle == 'sun-care' %}pill-soft{% endif %}">Sun Care</a>
        <a href="/collections/lip-balms" class="pill {% if current_handle == 'lip-balms' %}pill-soft{% endif %}">Lip Balms</a>
        <a href="/collections/sale" class="pill {% if current_handle == 'sale' %}pill-soft{% endif %}">Sale</a>
      </div>
      <form method="get" class="cluster" style="--gap: var(--space-2);">
        <span class="muted" style="font-size: var(--fs-sm);">{{ collection.products_count | default: collection.all_products_count }} products</span>
        <select name="sort_by" aria-label="Sort" onchange="this.form.submit()">
          <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Sort: Featured</option>
          <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Bestsellers</option>
          <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
          <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: low to high</option>
          <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: high to low</option>
        </select>
      </form>
    </div>

    <div class="grid product-grid">
      {%- if collection.products.size > 0 -%}
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {%- elsif collections.all.products.size > 0 -%}
        {% for product in collections.all.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {%- else -%}
        {% render 'mock-product-card',
          image: 'https://static.wixstatic.com/media/bf3c53_3f63a6bb7a204965ad128ad9ade77c05~mv2.webp/v1/fill/w_600,h_600,al_c,q_85/bf3c53_3f63a6bb7a204965ad128ad9ade77c05~mv2.webp',
