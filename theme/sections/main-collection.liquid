<section class="collection-hero">
  <div class="wrap">
    <h1 class="h1">{{ collection.title | default: 'The full INCIA range, distributed in the UK.' }}</h1>
    {% if collection.description != blank %}
      <p class="lead muted mt-3 mx-auto" style="max-width: 60ch;">{{ collection.description }}</p>
    {% else %}
      {%- assign intro_class = 'lead muted mt-3 mx-auto' -%}
      {%- case collection.handle -%}
        {%- when 'mom-baby-care' -%}
          <p class="{{ intro_class }}" style="max-width: 64ch;">Gentle, 100% natural skincare for babies, children and pregnancy. Dermatologically tested, fragrance-free and eczema-friendly INCIA formulas, from nappy rash gel and baby SPF50 to pregnancy-safe stretch mark care. Certified natural, dispatched from the UK.</p>
        {%- when 'sun-care-1' -%}
          <p class="{{ intro_class }}" style="max-width: 64ch;">Natural mineral sun protection for the whole family. SPF50 with non-nano titanium dioxide, reef-safe and free from chemical filters, suitable for babies, sensitive skin and everyday face wear. Certified, 100% natural INCIA sun care.</p>
        {%- when 'personal-care-1' -%}
          <p class="{{ intro_class }}" style="max-width: 64ch;">Clean personal care without synthetic aluminium that actually works. Natural deodorant for sensitive skin, sulphate-free shampoo and gentle everyday essentials. 100% natural, vegan and cruelty-free INCIA formulas.</p>
        {%- when 'lip-balms' -%}
          <p class="{{ intro_class }}" style="max-width: 64ch;">100% natural lip balms for dry, chapped lips. Nourishing plant oils and butters in kids and adult flavours, with no petroleum and no synthetic fragrance. Made with certified INCIA formulas.</p>
        {%- when 'bestsellers-1' -%}
          <p class="{{ intro_class }}" style="max-width: 64ch;">Our best-selling natural skincare, chosen by UK families. 100% natural, certified INCIA formulas, from mineral SPF50 to natural deodorant and baby-safe essentials.</p>
        {%- when 'must-haves-1' -%}
          <p class="{{ intro_class }}" style="max-width: 64ch;">The natural skincare essentials UK families reach for daily. Certified, 100% natural INCIA formulas for face, body and baby.</p>
        {%- when 'face-care' -%}
          <p class="{{ intro_class }}" style="max-width: 64ch;">Natural face care for everyday skin. A gentle foaming cleanser, mineral SPF50 light enough to wear under makeup, lash and brow serum, and nourishing lip balms. 100% natural, certified INCIA formulas.</p>
        {%- when 'hair-care' -%}
          <p class="{{ intro_class }}" style="max-width: 64ch;">Sulphate-free hair care for the whole family. Natural herbal shampoo, hair serum and an easy combing spray that makes tangles quicker, plus a gentle shampoo for babies and children.</p>
        {%- when 'home-care-1' -%}
          <p class="{{ intro_class }}" style="max-width: 64ch;">Natural, gentle home care. Plant-based, fragrance-free household essentials that are kind to sensitive skin and to the planet.</p>
        {%- when 'sale' -%}
          <p class="{{ intro_class }}" style="max-width: 64ch;">Save on 100% natural INCIA skincare. Certified, family-safe formulas, clean beauty at a better price, dispatched from the UK.</p>
        {%- else -%}
          <p class="{{ intro_class }}" style="max-width: 60ch;">{{ collections.all.products_count }} natural products from INCIA, already trusted across Europe for over 5 years. Now dispatched from the UK by INature.</p>
      {%- endcase -%}
    {% endif %}
  </div>
</section>

<section>
  <div class="wrap">
    <div class="collection-toolbar">
      <div class="filter-pills">
        {%- assign current_handle = collection.handle | default: 'all-products' -%}
        <a href="{{ routes.all_products_collection_url }}" class="pill {% if current_handle == 'all-products' or current_handle == '' %}pill-soft{% endif %}">All</a>
        <a href="/collections/bestsellers-1" class="pill {% if current_handle == 'bestsellers-1' %}pill-soft{% endif %}">Bestsellers</a>
        <a href="/collections/mom-baby-care" class="pill {% if current_handle == 'mom-baby-care' %}pill-soft{% endif %}">Mom &amp; Baby</a>
        <a href="/collections/personal-care-1" class="pill {% if current_handle == 'personal-care-1' %}pill-soft{% endif %}">Personal Care</a>
        <a href="/collections/sun-care-1" class="pill {% if current_handle == 'sun-care-1' %}pill-soft{% endif %}">Sun Care</a>
        <a href="/collections/face-care" class="pill {% if current_handle == 'face-care' %}pill-soft{% endif %}">Face Care</a>
        <a href="/collections/hair-care" class="pill {% if current_handle == 'hair-care' %}pill-soft{% endif %}">Hair Care</a>
        <a href="/collections/lip-balms" class="pill {% if current_handle == 'lip-balms' %}pill-soft{% endif %}">Lip Balms</a>
        <a href="/collections/home-care-1" class="pill {% if current_handle == 'home-care-1' %}pill-soft{% endif %}">Home Care</a>
        <a href="/collections/must-haves-1" class="pill {% if current_handle == 'must-haves-1' %}pill-soft{% endif %}">Must Haves</a>
        <a href="/collections/sale" class="pill {% if current_handle == 'sale' %}pill-soft{% endif %}">Sale</a>
      </div>
      <form method="get" class="cluster" style="--gap: var(--space-2);">
        <span class="muted" style="font-size: var(--fs-sm);">{{ collection.products_count | default: collection.all_products_count }} products</span>
        <select name="sort_by" aria-label="Sort" onchange="this.form.submit()">
          <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Sort: Featured</option>
          <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Bestsellers</option>
          <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
          <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: low to high</option>
          <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: high to low</option>
        </select>
      </form>
    </div>

    <div class="grid product-grid">
      {%- if collection.products.size > 0 -%}
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {%- elsif collections.all.products.size > 0 -%}
        {% for product in collections.all.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {%- else -%}
        <p class="muted" style="grid-column: 1 / -1; text-align: center; padding: var(--space-7) 0;">No products in this collection yet. <a href="{{ routes.all_products_collection_url }}" style="color: var(--primary-dark); text-decoration: underline;">Browse all products</a>.</p>
      {%- endif -%}
    </div>
  </div>
</section>

<div style="height: var(--space-8);" aria-hidden="true"></div>

{% schema %}
{
  "name": "Collection grid",
  "settings": [],
  "presets": [{ "name": "Collection grid" }]
}
{% endschema %}
