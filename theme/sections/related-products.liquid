<section class="section">
  <div class="wrap">
    <header class="section-head section-head--center text-center mx-auto">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Pairs well with' }}</span>
      <h2 class="h2">{{ section.settings.heading | default: 'Build the routine.' }}</h2>
    </header>
    <div class="grid product-grid">
      {%- comment -%} Real products from the bestsellers collection (excluding the current product), not mock data {%- endcomment -%}
      {%- assign rel = collections['bestsellers-1'].products -%}
      {%- if rel.size == 0 -%}{%- assign rel = collections.all.products -%}{%- endif -%}
      {%- assign shown = 0 -%}
      {%- for p in rel -%}
        {%- if product != blank and p.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
        {% render 'product-card', product: p %}
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
