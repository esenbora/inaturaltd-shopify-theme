<section class="ingredients section">
  <div class="wrap">
    {%- liquid
      assign before_url = 'skin-before.jpg' | asset_url
      if section.settings.before_image
        assign before_url = section.settings.before_image | image_url: width: 1200
      endif
      assign after_url = 'skin-after.jpg' | asset_url
      if section.settings.after_image
        assign after_url = section.settings.after_image | image_url: width: 1400
      endif
      assign cta_url = section.settings.cta_url | default: routes.all_products_collection_url
    -%}

    <div class="ba-block">
      <div class="ba" data-ba>
        <img class="ba__img ba__img--after" src="{{ after_url }}" alt="Calm, healthy skin after switching to INCIA natural care" loading="lazy">
        <div class="ba__before" data-ba-before>
          <img class="ba__img" src="{{ before_url }}" alt="Irritated, eczema-prone skin before INCIA natural care" loading="lazy">
        </div>
        <span class="ba__label ba__label--before">{{ section.settings.before_label | default: 'Before' }}</span>
        <span class="ba__label ba__label--after">{{ section.settings.after_label | default: 'After' }}</span>
        <span class="ba__divider" aria-hidden="true"></span>
        <span class="ba__handle" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 6 L4 12 L9 18"/>
            <path d="M15 6 L20 12 L15 18"/>
          </svg>
        </span>
        <input class="ba__range" type="range" min="0" max="100" value="50" step="0.1" aria-label="Drag to compare before and after" data-ba-range>
      </div>

      <div class="ba-block__copy">
        <span class="eyebrow">Discover the difference</span>
        <h2 class="h2">See the difference for yourself.</h2>
        <p class="lead muted">Sensitive, reactive or eczema-prone skin that flares up fast? Our formulas are made for the most delicate, dry skin, from gentle washes to rich creams. Used together they calm redness and itching for softer, more comfortable skin, just as our customers tell us every day.</p>
        <a href="{{ cta_url }}" class="btn btn-primary btn-lg">{{ section.settings.cta_label | default: 'Shop sensitive skin care' }} {% render 'icon', name: 'arrow-right' %}</a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-ba]').forEach(function (ba) {
      var range = ba.querySelector('[data-ba-range]');
      if (!range) return;
      function set(v) { ba.style.setProperty('--pos', v + '%'); }
      range.addEventListener('input', function () { set(range.value); });
      set(range.value);
    });
  })();
</script>

{% schema %}
{
  "name": "Before & after",
  "settings": [
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop sensitive skin care" },
    { "type": "url", "id": "cta_url", "label": "Button URL" }
  ],
  "presets": [{ "name": "Before & after" }]
}
{% endschema %}
