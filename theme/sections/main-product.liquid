{%- liquid
  assign p = product
  assign variant = product.selected_or_first_available_variant | default: product.variants.first
  assign on_sale = false
  if variant.compare_at_price > variant.price
    assign on_sale = true
  endif
  assign discount_pct = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round: 0
  assign rating = product.metafields.reviews.rating.value | default: 4.8
  assign review_count = product.metafields.reviews.count.value | default: 142
  assign breadcrumb_collection = product.collections.first
  assign p_vendor = product.vendor | default: 'INature UK'
  assign p_short = product.description | strip_html | truncate: 280
  assign sku_value = variant.sku | default: ''
  assign availability_schema = 'https://schema.org/OutOfStock'
  if variant.available
    assign availability_schema = 'https://schema.org/InStock'
  endif
  assign price_amount = variant.price | divided_by: 100.00
  assign currency_code = cart.currency.iso_code | default: shop.currency
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 5000 | json }},
  "image": [
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        {{ media | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  "sku": {{ sku_value | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ p_vendor | json }}
  },
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: product.url | json }},
    "priceCurrency": {{ currency_code | json }},
    "price": "{{ price_amount }}",
    "availability": {{ availability_schema | json }},
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>

<section class="wrap">
  <nav aria-label="Breadcrumb" style="padding-block: var(--space-5); font-size: var(--fs-xs); color: var(--muted); letter-spacing: .08em; text-transform: uppercase;">
    <a href="{{ routes.root_url }}">Home</a> ·
    {% if breadcrumb_collection %}
      <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title }}</a>
    {% else %}
      <a href="{{ routes.all_products_collection_url }}">All products</a>
    {% endif %}
    · <span>{{ product.title }}</span>
  </nav>

  <div class="pdp">
    <!-- Gallery -->
    <div class="pdp__gallery" data-gallery>
      {%- assign image_media = product.media | where: 'media_type', 'image' -%}
      {%- assign featured = image_media.first -%}
      <div class="pdp__main" data-gallery-main>
        {% if featured %}
          <img src="{{ featured | image_url: width: 1200 }}" alt="{{ featured.alt | escape | default: product.title }}" width="600" height="750">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      <div class="pdp__thumbs">
        {% for media in image_media limit: 6 %}
          <div class="pdp__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-thumb data-full="{{ media | image_url: width: 1200 }}">
            <img src="{{ media | image_url: width: 400 }}" alt="{{ media.alt | escape }}" width="200" height="250">
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Info -->
    <div class="pdp__info">
      {%- assign title_upper = product.title | upcase -%}
      {%- assign vendor_upper = p_vendor | upcase -%}
      {%- unless title_upper contains vendor_upper -%}
        <span class="pdp__vendor">{{ p_vendor }}</span>
      {%- endunless -%}
      <h1 class="pdp__title">{{ product.title }}</h1>
      {% if product.metafields.custom.tagline.value != blank %}
        <p class="pdp__subtitle muted" style="font-size: var(--fs-base); margin: -10px 0 0;">{{ product.metafields.custom.tagline.value }}</p>
      {% endif %}

      <div class="pdp__rating">
        <span class="rating__stars" style="color: var(--accent); letter-spacing: 2px;">★★★★★</span>
        <strong style="font-size: var(--fs-sm);">{{ rating }}</strong>
        <span class="muted" style="font-size: var(--fs-sm);">· {{ review_count }} verified reviews</span>
      </div>

      <div class="pdp__price">
        {% if on_sale %}
          <span style="color: var(--muted); text-decoration: line-through; font-size: var(--fs-xl);">{{ variant.compare_at_price | money }}</span>
        {% endif %}
        <span>{{ variant.price | money }}</span>
        {% if on_sale %}
          <span class="pill pill-accent">Save {{ discount_pct }}%</span>
        {% endif %}
      </div>

      <p class="pdp__short">{{ p_short }}</p>

      {% if product.has_only_default_variant == false %}
        {% for option in product.options_with_values %}
          <div class="pdp__variants">
            <span class="pdp__variant-label">{{ option.name }}</span>
            <div class="swatch-row" data-swatch-group>
              {% for value in option.values %}
                <button class="swatch{% if option.selected_value == value %} is-active{% endif %}" type="button" data-option-index="{{ forloop.parentloop.index0 }}" data-option-value="{{ value | escape }}">{{ value }}</button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endif %}

      <!-- Add to cart row -->
      <div class="qty-row">
        <div class="qty" data-qty>
          <button type="button" data-qty-dec aria-label="Decrease">−</button>
          <input type="number" value="1" min="1" aria-label="Quantity">
          <button type="button" data-qty-inc aria-label="Increase">+</button>
        </div>
        <button class="btn btn-primary btn-lg btn-block" data-add-to-cart data-variant-id="{{ variant.id }}" data-label="Add to bag — {{ variant.price | money }}"{% if variant.available == false %} disabled{% endif %}>
          {% if variant.available %}Add to bag — {{ variant.price | money }}{% else %}Sold out{% endif %}
        </button>
      </div>

      <a href="#" style="text-align: center; font-size: var(--fs-sm); color: var(--muted); text-decoration: underline;">Buy with shop pay →</a>

      <!-- Perks -->
      <div class="pdp__perks">
        <div class="perk">{% render 'icon', name: 'truck' %} <span><strong>Free UK shipping over £20</strong> — £3 below. Dispatched via Evri, usually 1-3 working days.</span></div>
        <div class="perk">{% render 'icon', name: 'shield' %} <span><strong>14-day return policy.</strong> Unused, original packaging — we&apos;ll exchange or refund.</span></div>
        <div class="perk">{% render 'icon', name: 'heart' %} <span><strong>Spend £12+ → free gift.</strong> Add a Lip Balm or Diaper Rash Gel — on us.</span></div>
        <div class="perk">{% render 'icon', name: 'leaf' %} <span><strong>ETKO Cosmos · BioArge · Vegan · Cruelty-Free.</strong> 100% natural origin. Made in Türkiye.</span></div>
      </div>

      <!-- Accordion -->
      <div class="accordion mt-3">
        <details open>
          <summary>About this product</summary>
          <div>{{ product.description }}</div>
        </details>
        <details>
          <summary>How to use</summary>
          <div>Apply to clean, dry skin. Reapply throughout the day as needed. We recommend a patch test first if you have sensitive or reactive skin. Safe for the whole family.</div>
        </details>
        <details>
          <summary>Ingredients &amp; certifications</summary>
          <div>100% natural origin. ETKO Cosmos certified. BioArge formulation. Vegan. Cruelty-Free. Free from parabens, mineral oils, artificial fragrances and synthetic preservatives. Made in Türkiye, distributed in the UK by INature.</div>
        </details>
        <details>
          <summary>Shipping &amp; returns</summary>
          <div>Dispatched from the UK via Evri. Free UK shipping on orders over £20 (£3 below). 14-day return policy on unused items in original packaging. International shipping available at checkout.{% if sku_value != blank %} SKU: {{ sku_value }}.{% endif %}</div>
        </details>
      </div>
    </div>
  </div>
</section>

<!-- Mobile sticky add-to-cart -->
<div class="pdp-sticky">
  <div style="font-size: var(--fs-sm);">
    <strong>{{ product.title | truncate: 30 }}</strong><br>
    <span class="muted">{{ variant.price | money }}</span>
  </div>
  <button class="btn btn-primary" data-add-to-cart data-variant-id="{{ variant.id }}" data-label="Add to bag" type="button"{% if variant.available == false %} disabled{% endif %}>
    {% if variant.available %}Add to bag{% else %}Sold out{% endif %}
  </button>
</div>

{% schema %}
{
  "name": "Product main",
  "settings": [],
  "presets": [{ "name": "Product main" }]
}
{% endschema %}
