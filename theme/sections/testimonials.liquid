<section class="reviews section">
  <div class="wrap">
    <header class="section-head section-head--center text-center mx-auto" style="color: var(--bg);">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Reviews' }}</span>
      <h2 class="h2" style="color: var(--bg);">{{ section.settings.heading | default: '100% positive feedback, straight from our buyers.' }}</h2>
      <p class="lead" style="color: rgba(248,244,237,.72);">{{ section.settings.subheading | default: 'Real, verified eBay reviews from families across the UK.' }}</p>
    </header>
  </div>

  {%- capture review_cards -%}
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <article class="rev-card" {{ block.shopify_attributes }}>
          <span class="rev-card__stars">★★★★★</span>
          <p class="rev-card__quote">{{ block.settings.quote }}</p>
          <div class="rev-card__meta">
            <span class="rev-card__name">{{ block.settings.name }}</span>
            <span class="rev-card__verified">{% render 'icon', name: 'check' %} eBay{% if block.settings.product != blank %} · {{ block.settings.product }}{% endif %}</span>
          </div>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- assign quotes = "Received this morning. Happy with product and is exactly as described, thank you~~~Quick delivery, exactly what I wanted. Lovely note in the box, thank you guys, I wish you all a Merry Christmas and Happy New Year~~~My first item was lost by the courier, but the INature team kept me informed every step of the way and promptly sent a replacement. A lovely natural deodorant which smells gorgeous. 100% recommended.~~~To be honest this item surpassed my expectations. Arrived well-packaged and exactly as described, what impressed me most was the quality. Worth every cent. Communication quick, shipping fast.~~~Incia Natural Roll-On is the most effective and natural deodorant I've purchased on eBay. Fantastic scent and a gentle formula, perfect for daily use. Highly recommend!~~~Just tried the Roll-On Deodorant for Sensitive Skin. It's gentle, smells great, and really works! Love that it's 100% natural, highly recommend.~~~An excellent alcohol-free, perfume-free product with extremely clean ingredients. Provides a great clean.~~~Great, safe product, we will use it on our newborn baby with peace of mind.~~~Using it for 6 days now. I like the smell, it doesn't disturb me like other roll-ons, and it works well. Definitely recommended.~~~Lovely cream, a little pricey but to be expected when it's organic. Soaks into the skin very well.~~~Soaks into skin well. Fast delivery and a very nice touch with a couple of samples.~~~Just arrived, looking forward to trying it, thank you for the freebies xx~~~Excellent product. I would definitely recommend for extra dry cuticles.~~~Lovely natural, cruelty-free product from a lovely seller. A++++++~~~Very pleased with the effect on my nails over the past two days.~~~Great product at a great price, fast delivery too.~~~Nice dry balm for the hands & feet!~~~Order delivered on time with no issues." | split: "~~~" -%}
      {%- assign names = "Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer~~~Verified buyer" | split: "~~~" -%}
      {%- assign prods = "Baby & Child Sunscreen SPF50~~~Intensive Repair Cream~~~Natural Deodorant~~~Intensive Repair Cream~~~Roll-on Deodorant~~~Roll-on Deodorant~~~Baby Laundry Soap~~~Natural Baby Oil~~~Natural Deodorant~~~Intensive Repair Cream~~~SOS Stick~~~Dishwashing Soap~~~SOS Stick~~~SOS Stick~~~SOS Stick~~~SOS Stick~~~SOS Stick~~~Roll-on Deodorant" | split: "~~~" -%}
      {%- for q in quotes -%}
        <article class="rev-card">
          <span class="rev-card__stars">★★★★★</span>
          <p class="rev-card__quote">{{ q }}</p>
          <div class="rev-card__meta">
            <span class="rev-card__name">{{ names[forloop.index0] }}</span>
            <span class="rev-card__verified">{% render 'icon', name: 'check' %} eBay · {{ prods[forloop.index0] }}</span>
          </div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  <div class="reviews-marquee" data-reviews-marquee>
    <div class="reviews-marquee__track">
      {{ review_cards }}
      {{ review_cards }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews marquee",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "product", "label": "Product purchased" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [{ "name": "Reviews marquee" }]
}
{% endschema %}
