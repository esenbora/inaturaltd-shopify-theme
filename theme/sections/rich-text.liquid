<section class="section">
  <div class="wrap" style="max-width: 720px;">
    {% if page.title %}<h1 class="h1 mb-5">{{ page.title }}</h1>{% endif %}
    {%- if page.handle == 'faq' -%}
      {% render 'faq-accordion' %}
    {%- elsif page.content != blank -%}
      <div class="flow" style="--flow: 1.2em; line-height: 1.7;">{{ page.content }}</div>
    {%- else -%}
      <div class="flow" style="--flow: 1.2em; line-height: 1.7;">
        {%- case page.handle -%}
          {%- when 'about' -%}{% render 'page-about' %}
          {%- when 'contact' -%}{% render 'page-contact' %}
          {%- when 'shipping-returns' -%}{% render 'page-shipping-returns' %}
          {%- when 'terms-conditions' -%}{% render 'page-terms-conditions' %}
          {%- when 'privacy-policy' -%}{% render 'page-privacy-policy' %}
          {%- else -%}{{ section.settings.body }}
        {%- endcase -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "richtext", "id": "body", "label": "Body" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
