<section class="section">
  <div class="wrap">
    <header class="section-head section-head--split">
      <div class="stack" style="--gap: var(--space-3);">
        <span class="eyebrow">{{ section.settings.eyebrow | default: 'Customer Favourites' }}</span>
        <h2 class="h2">{{ section.settings.heading | default: 'Your most-loved natural essentials.' }}</h2>
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline">{{ section.settings.cta_label | default: 'Shop all' }} {% render 'icon', name: 'arrow-right' %}</a>
    </header>
  </div>

  {%- comment -%} Bestsellers collection, auto-scrolling marquee (pauses on hover, pointer devices only). {%- endcomment -%}
  {%- assign fav_products = collections['bestsellers-1'].products -%}
  {%- if fav_products.size == 0 -%}{%- assign fav_products = collections.all.products -%}{%- endif -%}

  <div class="pmarquee" aria-label="Bestsellers" data-pmarquee>
    <button class="pmarquee__nav pmarquee__nav--prev" type="button" aria-label="Previous products" data-pm-prev>{% render 'icon', name: 'arrow-right' %}</button>
    <div class="pmarquee__viewport" data-pm-viewport>
      <div class="pmarquee__track">
        {%- for fav in fav_products -%}
          {% render 'product-card', product: fav %}
        {%- endfor -%}
        {%- comment -%} Duplicate set for a seamless infinite loop. {%- endcomment -%}
        {%- for fav in fav_products -%}
          {% render 'product-card', product: fav %}
        {%- endfor -%}
      </div>
    </div>
    <button class="pmarquee__nav pmarquee__nav--next" type="button" aria-label="Next products" data-pm-next>{% render 'icon', name: 'arrow-right' %}</button>
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('#shopify-section-{{ section.id }} [data-pmarquee]');
  if (!root) return;
  var vp = root.querySelector('[data-pm-viewport]');
  var track = root.querySelector('.pmarquee__track');
  if (!vp || !track) return;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var paused = false;

  function setW() { return track.scrollWidth / 2; }            // one product set
  function norm() { var w = setW(); if (w > 0 && vp.scrollLeft >= w) vp.scrollLeft -= w; }
  function cardW() { var c = track.querySelector('.product-card'); return c ? c.getBoundingClientRect().width + 20 : 290; }

  vp.addEventListener('scroll', norm, { passive: true });

  // Auto-advance ~50px/s, matching the brand-value strips. Pauses on interaction.
  if (!reduce) {
    setInterval(function () { if (!paused && !document.hidden) { vp.scrollLeft += 1; norm(); } }, 20);
  }
  var resumeT;
  function pause() { paused = true; clearTimeout(resumeT); }
  function resume() { clearTimeout(resumeT); resumeT = setTimeout(function () { paused = false; }, 1200); }
  root.addEventListener('mouseenter', pause);
  root.addEventListener('mouseleave', resume);
  root.addEventListener('touchstart', pause, { passive: true });
  root.addEventListener('touchend', resume, { passive: true });
  root.addEventListener('focusin', pause);
  root.addEventListener('focusout', resume);

  function nudge(dir) {
    pause();
    var w = setW();
    if (dir < 0 && vp.scrollLeft < cardW()) vp.scrollLeft += w;   // pre-wrap so prev is infinite
    vp.scrollBy({ left: dir * cardW() * 2, behavior: 'smooth' });
    setTimeout(function () { norm(); resume(); }, 600);
  }
  var prev = root.querySelector('[data-pm-prev]');
  var next = root.querySelector('[data-pm-next]');
  if (prev) prev.addEventListener('click', function () { nudge(-1); });
  if (next) next.addEventListener('click', function () { nudge(1); });
})();
</script>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer Favourites" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection", "id": "collection", "label": "Collection (unused)" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop all" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
