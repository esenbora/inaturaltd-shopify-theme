<section class="announce" aria-label="Announcements">
  <div class="announce__marquee" aria-hidden="true">
    <div class="announce__track">
      {%- comment -%} Render messages twice for seamless loop {%- endcomment -%}
      {% for repeat in (1..2) %}
        {% for block in section.blocks %}
          <span class="announce__item">
            {% if block.settings.icon != blank %}{{ block.settings.icon }}{% endif %}
            {{ block.settings.text | replace: '£5.95 off', '15% off' | replace: '£5.95 OFF', '15% OFF' | replace: '£5.95', '15%' | replace: ' with code "NEWLIFE"', '' | replace: ' with code NEWLIFE', '' | replace: 'NEWLIFE', '' | replace: ' or Diaper Rash Gel', '' | replace: '£12', '£20' }}
          </span>
        {% else %}
          <span class="announce__item">✦ Free UK shipping over £20</span>
          <span class="announce__item">✦ Official UK distributor for INCIA Naturals</span>
          <span class="announce__item">✦ 15% off your first order for new customers</span>
          <span class="announce__item">✦ 14-day returns, no questions</span>
          <span class="announce__item">✦ ETKO Cosmos certified · Vegan · Cruelty-free</span>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
  <p class="visually-hidden">
    {% for block in section.blocks %}{{ block.settings.text | replace: '£5.95', '15%' }}. {% else %}Free UK shipping over £20. Official UK distributor for INCIA Naturals. 15% off your first order for new customers.{% endfor %}
  </p>
</section>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK shipping over £20" },
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✦" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Announcement bar" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
