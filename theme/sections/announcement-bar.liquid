<section class="announce" aria-label="Announcements">
  <div class="announce__marquee" aria-hidden="true">
    <div class="announce__track">
      {%- comment -%} Render messages twice for seamless loop {%- endcomment -%}
      {% for repeat in (1..2) %}
        {% for block in section.blocks %}
          <span class="announce__item">
            {% if block.settings.icon != blank %}{{ block.settings.icon }}{% endif %}
            {{ block.settings.text }}
          </span>
        {% else %}
          <span class="announce__item">✦ Free UK shipping over £20</span>
          <span class="announce__item">✦ Spend £12+ → free Lip Balm or Diaper Rash Gel</span>
          <span class="announce__item">✦ 20% off your first order — code NEWLIFE10</span>
          <span class="announce__item">✦ 14-day returns — no questions</span>
          <span class="announce__item">✦ ETKO Cosmos certified · Vegan · Cruelty-free</span>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
  <p class="visually-hidden">
    {% for block in section.blocks %}{{ block.settings.text }}. {% else %}Free UK shipping over £20. Spend £12+ for a free Lip Balm or Diaper Rash Gel. 20% off your first order with code NEWLIFE10.{% endfor %}
  </p>
</section>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK shipping over £20" },
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✦" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Announcement bar" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
